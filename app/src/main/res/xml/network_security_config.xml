<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows HTTP (not just HTTPS) to reach the CircleFTP server.
    Android 9+ blocks cleartext traffic by default; this opt-in is required.
    Cleartext is permitted for all hosts (the FTP uses http:// hostnames).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
